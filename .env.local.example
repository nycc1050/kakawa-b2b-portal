NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role key: server-only, bypasses RLS. Get it from Supabase
# Dashboard -> Project Settings -> API -> API Keys -> service_role.
# Never expose this to the browser or commit it.
SUPABASE_SERVICE_ROLE_KEY=

# Optional: used by `npm run seed` to invite yourself as the first admin.
SEED_ADMIN_EMAIL=
